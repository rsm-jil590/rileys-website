```{r}
#| label: setup
#| echo: false
library(dplyr)
library(tidyr)
library(ggplot2)
library(knitr)
library(kableExtra)

set.seed(495)

theme_set(theme_minimal(base_size = 12))

palette_courses <- c(
  "#2C5F8D", "#C97B4A", "#5A9C5E", "#8E5EA2", "#D95F5F",
  "#4A8C8A", "#B8945A", "#6A6A6A", "#1B9E77", "#7570B3"
)

short_label <- function(x) {
  sub(" \\(.*$", "", x)
}

pct <- function(x, digits = 1) {
  paste0(round(100 * x, digits), "%")
}

raw <- read.csv("maxdiff_design_and_choices.csv", check.names = FALSE)
names(raw)[1:5] <- c("Record ID", "Task", "Position", "Item", "Response")

labels_raw <- read.csv("maxdiff_item_labels.csv", check.names = FALSE)
labels <- labels_raw[, 1:2]
names(labels) <- c("Item", "item_label")
labels <- labels |>
  mutate(
    Item = as.integer(Item),
    short_label = short_label(item_label)
  )

raw <- raw |>
  group_by(`Record ID`, Task) |>
  mutate(items_per_task = n()) |>
  ungroup()

raw_task_summary <- raw |>
  distinct(`Record ID`, Task, items_per_task) |>
  count(items_per_task, name = "tasks")

# The attached file includes the 4-option MaxDiff tasks plus later 2-option
# follow-up tasks with item 11. The assignment and label file define the 10
# course-item MaxDiff study, so the models below use only the 4-option tasks.
maxdiff <- raw |>
  filter(items_per_task == 4, Item %in% labels$Item) |>
  select(`Record ID`, Task, Position, Item, Response)

all_items <- sort(unique(labels$Item))

tasks_per_respondent <- maxdiff |>
  distinct(`Record ID`, Task) |>
  count(`Record ID`, name = "tasks")

N <- n_distinct(maxdiff$`Record ID`)
T_tasks <- unique(tasks_per_respondent$tasks)
J <- maxdiff |>
  count(`Record ID`, Task, name = "items_shown") |>
  pull(items_shown) |>
  unique()
K_items <- length(all_items)

sanity <- maxdiff |>
  group_by(`Record ID`, Task) |>
  summarise(
    rows = n(),
    best_picks = sum(Response == 1),
    worst_picks = sum(Response == -1),
    neutral_rows = sum(Response == 0),
    .groups = "drop"
  ) |>
  mutate(ok = rows == 4 & best_picks == 1 & worst_picks == 1 & neutral_rows == 2)

design_summary <- tibble(
  Metric = c(
    "Respondents",
    "MaxDiff tasks per respondent",
    "Items shown per task",
    "Course items in the study",
    "MaxDiff tasks analyzed",
    "Task-rows analyzed",
    "Excluded follow-up tasks"
  ),
  Value = c(
    N,
    paste(T_tasks, collapse = ", "),
    paste(J, collapse = ", "),
    K_items,
    nrow(sanity),
    nrow(maxdiff),
    raw_task_summary |>
      filter(items_per_task == 2) |>
      pull(tasks)
  )
)

exposure <- maxdiff |>
  count(Item, name = "times_shown") |>
  left_join(labels, by = "Item") |>
  arrange(Item)

counts <- maxdiff |>
  group_by(Item) |>
  summarise(
    times_shown = n(),
    times_best = sum(Response == 1),
    times_worst = sum(Response == -1),
    pct_best = times_best / times_shown,
    pct_worst = times_worst / times_shown,
    counts_score = pct_best - pct_worst,
    .groups = "drop"
  ) |>
  left_join(labels, by = "Item") |>
  arrange(desc(counts_score)) |>
  mutate(counts_rank = row_number())

score_for <- function(dat) {
  out <- dat |>
    count(Item, Response, name = "n") |>
    complete(Item = all_items, Response = c(-1, 0, 1), fill = list(n = 0)) |>
    group_by(Item) |>
    summarise(
      shown = sum(n),
      best = sum(n[Response == 1]),
      worst = sum(n[Response == -1]),
      score = best / shown - worst / shown,
      .groups = "drop"
    ) |>
    arrange(Item)
  out$score
}

B <- 1000
respondent_chunks <- split(maxdiff, maxdiff$`Record ID`)
boot_scores <- replicate(B, {
  sampled_ids <- sample(names(respondent_chunks), length(respondent_chunks), replace = TRUE)
  boot_dat <- do.call(rbind, respondent_chunks[sampled_ids])
  score_for(boot_dat)
})

count_ci <- tibble(
  Item = all_items,
  counts_low = apply(boot_scores, 1, quantile, probs = 0.025),
  counts_high = apply(boot_scores, 1, quantile, probs = 0.975)
)

counts <- counts |>
  left_join(count_ci, by = "Item")

task_df <- maxdiff |>
  arrange(`Record ID`, Task, Position) |>
  group_by(`Record ID`, Task) |>
  summarise(
    shown = list(Item),
    best = Item[Response == 1],
    worst = Item[Response == -1],
    .groups = "drop"
  )

shown_mat <- do.call(rbind, task_df$shown)
best_vec <- task_df$best
worst_vec <- task_df$worst
remaining_mat <- t(mapply(
  function(shown, best) shown[shown != best],
  task_df$shown,
  best_vec
))

row_lse <- function(mat) {
  row_max <- apply(mat, 1, max)
  row_max + log(rowSums(exp(mat - row_max)))
}

ll <- function(theta) {
  beta <- c(0, theta)
  shown_util <- matrix(beta[shown_mat], nrow = nrow(shown_mat))
  remaining_disutility <- matrix(-beta[remaining_mat], nrow = nrow(remaining_mat))

  sum(
    beta[best_vec] -
      row_lse(shown_util) -
      beta[worst_vec] -
      row_lse(remaining_disutility)
  )
}

mle_fit <- optim(
  par = rep(0, K_items - 1),
  fn = ll,
  method = "BFGS",
  hessian = TRUE,
  control = list(fnscale = -1, maxit = 1000)
)

beta_hat <- c(0, mle_fit$par)
vcov_free <- solve(-mle_fit$hessian)
se_hat <- c(NA_real_, sqrt(diag(vcov_free)))
mle_share <- exp(beta_hat) / sum(exp(beta_hat))

mle_results <- labels |>
  mutate(
    beta_hat = beta_hat[Item],
    se_hat = se_hat[Item],
    mle_share = mle_share[Item]
  ) |>
  arrange(desc(mle_share)) |>
  mutate(mle_rank = row_number())

log_post <- function(theta) {
  ll(theta) + sum(dnorm(theta, mean = 0, sd = sqrt(10), log = TRUE))
}

mh <- function(beta0, n_iter, step) {
  K <- length(beta0)
  draws <- matrix(NA_real_, n_iter, K)
  beta <- beta0
  lp <- log_post(beta)
  accept <- 0L

  for (iter in seq_len(n_iter)) {
    beta_star <- beta + rnorm(K, mean = 0, sd = step)
    lp_star <- log_post(beta_star)

    if (log(runif(1)) < lp_star - lp) {
      beta <- beta_star
      lp <- lp_star
      accept <- accept + 1L
    }

    draws[iter, ] <- beta
  }

  list(draws = draws, accept_rate = accept / n_iter)
}

n_iter <- 20000
burn <- 5000
mh_fit <- mh(beta0 = mle_fit$par, n_iter = n_iter, step = 0.07)

post_draws_free <- mh_fit$draws[(burn + 1):n_iter, , drop = FALSE]
post_beta_draws <- cbind(0, post_draws_free)
colnames(post_beta_draws) <- paste0("Item ", all_items)

post_beta_mean <- colMeans(post_beta_draws)
post_beta_ci <- t(apply(post_beta_draws, 2, quantile, probs = c(0.025, 0.975)))

post_share_draws <- exp(post_beta_draws) / rowSums(exp(post_beta_draws))
post_share_mean <- colMeans(post_share_draws)
post_share_ci <- t(apply(post_share_draws, 2, quantile, probs = c(0.025, 0.975)))

bayes_results <- labels |>
  mutate(
    post_beta_mean = post_beta_mean[Item],
    beta_low = post_beta_ci[Item, 1],
    beta_high = post_beta_ci[Item, 2],
    bayes_share = post_share_mean[Item],
    share_low = post_share_ci[Item, 1],
    share_high = post_share_ci[Item, 2]
  ) |>
  arrange(desc(bayes_share)) |>
  mutate(bayes_rank = row_number())

comparison <- counts |>
  select(Item, item_label, short_label, counts_score, counts_rank) |>
  left_join(
    mle_results |> select(Item, mle_share, mle_rank),
    by = "Item"
  ) |>
  left_join(
    bayes_results |> select(Item, bayes_share, bayes_rank),
    by = "Item"
  ) |>
  arrange(mle_rank)
```

